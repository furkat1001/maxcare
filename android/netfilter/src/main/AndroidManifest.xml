<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- «Частный DNS» читается из свойств сети. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <!--
            Фильтр сайтов (VPN только для DNS). Google Play: декларация VpnService, родительский
            контроль — разрешённый случай; запросы к DNS-провайдеру шифруются (DoH).
        -->
        <service
            android:name=".vpn.MaxCareVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <!-- Режим Device Owner включает этот VPN как постоянный (always-on). -->
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>
    </application>

</manifest>
