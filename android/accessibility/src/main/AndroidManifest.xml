<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Предупреждение «осталось 2 минуты» перед ограничением времени. То же разрешение уже
        объявлено в protection (постоянное уведомление), нового разрешения у приложения нет.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Ограничения времени: лаунчер не блокируется, а категория и название нужны только
        запускаемым приложениям. Без QUERY_ALL_PACKAGES — как в модуле reports.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <!--
            Служба доступности фильтра контента: читает текст на экране ребёнка.
            Google Play: заметное раскрытие в приложении и декларация — родительский контроль.
            Ребёнок включает её вручную; скрытых режимов нет (значок и уведомление MaxCare видны).
        -->
        <service
            android:name=".ContentFilterService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
