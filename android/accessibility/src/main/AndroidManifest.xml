<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Служба доступности фильтра контента: читает текст на экране ребёнка.
            Google Play: заметное раскрытие в приложении и декларация — родительский контроль.
            Ребёнок включает её вручную; скрытых режимов нет (значок и уведомление MaxCare видны).
        -->
        <service
            android:name=".ContentFilterService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
