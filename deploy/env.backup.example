# Образец deploy/.env.backup — копии базы вне сервера (см. backup.sh, docs/deploy-vps.md).
# Настоящий файл только на сервере, права 600, в репозиторий не попадает.

# Открытый ключ age (начинается с age1...). Закрытый — только у владельца, не на сервере.
BACKUP_AGE_RECIPIENT=age1...

# Backblaze B2: ключ только этого бакета, тип доступа Write Only.
BACKUP_B2_KEY_ID=
BACKUP_B2_APP_KEY=
BACKUP_B2_BUCKET=
