# Шаблон. На сервере скопировать в .env рядом с docker-compose.yml (chmod 600) и заполнить. Сам .env в репозиторий НЕ коммитить.

# Домен API и почта для писем Let's Encrypt (истечение сертификата и т.п.).
API_DOMAIN=api.maxcare.dexx.uz
ACME_EMAIL=

# 32 случайных байта в base64: openssl rand -base64 32
# Шифрует секреты восстановления паролей. Потеряете — старые коды восстановления перестанут работать.
MAXCARE_SECRET_KEY=

# Пароль базы: openssl rand -base64 24
POSTGRES_PASSWORD=

# ID OAuth-клиентов Google через запятую (docs/google-sign-in.md); пусто — вход через Google выключен.
MAXCARE_GOOGLE_CLIENT_IDS=

# Подписка через RevenueCat (docs/revenuecat.md). Пусто — оплата выключена, у всех пробный период.
# Секретный ключ REST API (sk_…): только здесь, в приложение и в чат — никогда.
MAXCARE_REVENUECAT_API_KEY=
# Значение заголовка Authorization для уведомлений RevenueCat, например: Bearer <openssl rand -hex 32>
MAXCARE_REVENUECAT_WEBHOOK_AUTH=
